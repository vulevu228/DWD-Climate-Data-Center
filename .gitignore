# --- raw downloads (multi-GB zips, re-fetched from opendata.dwd.de) ---
raw/

# --- parsed output: big and reproducible from raw/, not committed ---
data/*.parquet

# --- scheduled-run logs ---
logs/

# --- local notes on how to reach the DWD server, not needed on GitHub ---
API_ACCESS.txt

# --- python junk ---
__pycache__/
*.pyc
.venv/
venv/

# --- editor / OS junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Power BI temp / recovery files (keep the .pbix itself) ---
*.pbix.tmp
~$*

# --- Power BI Project (.pbip) local cache & per-user settings ---
# cache.abf is a regenerable compiled data cache (can be 100s of MB); localSettings.json
# holds per-machine window/auth state. Neither belongs in source control.
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
